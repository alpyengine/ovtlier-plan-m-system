// ═══════════════════════════════════════════════════════════════
// © Ovtlier Quant | Position Sizer v1
// Calcula el tamaño de posición usando la fórmula ATR de Uhl
// Metodología: Outlier University — Christopher Uhl
// ═══════════════════════════════════════════════════════════════
//@version=6
indicator("Outlier Position Sizer v1", overlay=true)

// ─── INPUTS ───────────────────────────────────────────────────
float balanceInput   = input.float(25000, "Balance de cuenta ($)",    group="💼 Cuenta",   minval=100,  step=1000)
float riskPctInput   = input.float(1.0,   "Riesgo por operación (%)", group="💼 Cuenta",   minval=0.1,  maxval=5.0, step=0.1)
int   atrLenInput    = input.int(14,      "Longitud ATR",             group="📊 ATR",       minval=1)
float atrMultInput   = input.float(2.0,   "Multiplicador ATR (stop)", group="📊 ATR",       minval=0.5,  step=0.5)
bool  isOptionsInput = input.bool(false,  "¿Es una opción?",          group="📈 Opciones")
float deltaInput     = input.float(0.70,  "Delta de la opción",       group="📈 Opciones",  minval=0.05, maxval=1.0, step=0.05)

// ─── FUNCIONES ────────────────────────────────────────────────

//@function Calcula el riesgo en dólares basado en el balance y el % de riesgo
//@param bal   (float) Balance total de la cuenta
//@param pct   (float) Porcentaje de riesgo por operación
//@returns     Dólares máximos a arriesgar en esta operación
calcDollarRisk(float bal, float pct) =>
    bal * (pct / 100)

//@function Calcula la distancia del stop loss usando ATR
//@param atrValue (float) Valor del ATR actual
//@param mult     (float) Multiplicador aplicado al ATR
//@returns        Distancia en dólares desde entrada hasta stop
calcStopDistance(float atrValue, float mult) =>
    atrValue * mult

//@function Calcula el número de acciones a comprar
//@param dollarRisk (float) Riesgo máximo en dólares
//@param stopDist   (float) Distancia del stop loss en dólares
//@returns          Número entero de acciones
calcShares(float dollarRisk, float stopDist) =>
    stopDist > 0 ? math.floor(dollarRisk / stopDist) : 0

// ─── CÁLCULOS PRINCIPALES ─────────────────────────────────────
float atrValue    = ta.atr(atrLenInput)                        // ATR del símbolo actual
float dollarRisk  = calcDollarRisk(balanceInput, riskPctInput) // Riesgo en $ = Balance × Riesgo%
float stopDist    = calcStopDistance(atrValue, atrMultInput)   // Stop en $ = ATR × Multiplicador
float stopPrice   = close - stopDist                           // Precio de stop dinámico
int   rawShares   = calcShares(dollarRisk, stopDist)           // Acciones = Riesgo$ / Stop$
int   contracts   = isOptionsInput and deltaInput > 0 ?
     math.floor(rawShares / 100 / deltaInput) : 0             // Contratos = Acciones / 100 / Delta
float capitalUsed = isOptionsInput ?
     contracts * 100 * close : rawShares * close              // Capital total comprometido
float capitalPct  = balanceInput > 0 ?
     (capitalUsed / balanceInput) * 100 : 0                   // % del balance usado

// ─── TABLA DE RESULTADOS ──────────────────────────────────────
var table psTable = table.new(
     position.top_right, 2, 7,
     border_width = 1, border_color = color.new(color.gray, 70),
     frame_width  = 1, frame_color  = color.new(color.gray, 50))

color headerBg  = color.new(color.navy, 10)
color rowBg     = color.new(color.white, 5)
color warnColor = capitalPct > 30 ? color.red : color.teal

if barstate.islast
    // ── Cabecera ──────────────────────────────────────────────
    table.cell(psTable, 0, 0, "OUTLIER POSITION SIZER",
         text_color   = color.white,
         bgcolor      = headerBg,
         text_size    = size.small,
         text_halign  = text.align_left)
    table.cell(psTable, 1, 0, syminfo.ticker,
         text_color   = color.yellow,
         bgcolor      = headerBg,
         text_size    = size.small,
         text_halign  = text.align_right)

    // ── Fila 1: Riesgo en dólares ─────────────────────────────
    table.cell(psTable, 0, 1, "💰 Riesgo ($)",
         text_color = color.gray, bgcolor = rowBg, text_size = size.tiny)
    table.cell(psTable, 1, 1, "$" + str.tostring(dollarRisk, "#.##"),
         text_color = color.white, bgcolor = rowBg, text_size = size.tiny)

    // ── Fila 2: ATR actual ────────────────────────────────────
    table.cell(psTable, 0, 2, "📊 ATR(" + str.tostring(atrLenInput) + ")",
         text_color = color.gray, bgcolor = rowBg, text_size = size.tiny)
    table.cell(psTable, 1, 2, str.tostring(atrValue, "#.##"),
         text_color = color.white, bgcolor = rowBg, text_size = size.tiny)

    // ── Fila 3: Stop Loss ─────────────────────────────────────
    table.cell(psTable, 0, 3, "🛑 Stop Loss",
         text_color = color.gray, bgcolor = rowBg, text_size = size.tiny)
    table.cell(psTable, 1, 3, "$" + str.tostring(stopPrice, "#.##"),
         text_color = color.red, bgcolor = rowBg, text_size = size.tiny)

    // ── Fila 4: Acciones o contratos ──────────────────────────
    string unitsLabel = isOptionsInput ? "📑 Contratos" : "📦 Acciones"
    int    unitsValue = isOptionsInput ? contracts : rawShares
    table.cell(psTable, 0, 4, unitsLabel,
         text_color = color.gray, bgcolor = rowBg, text_size = size.tiny)
    table.cell(psTable, 1, 4, str.tostring(unitsValue),
         text_color = color.teal, bgcolor = rowBg, text_size = size.small)

    // ── Fila 5: Capital comprometido ──────────────────────────
    table.cell(psTable, 0, 5, "💼 Capital usado",
         text_color = color.gray, bgcolor = rowBg, text_size = size.tiny)
    table.cell(psTable, 1, 5,
         "$" + str.tostring(math.round(capitalUsed)) +
         " (" + str.tostring(capitalPct, "#.#") + "%)",
         text_color = warnColor, bgcolor = rowBg, text_size = size.tiny)

    // ── Fila 6: Alerta de riesgo ──────────────────────────────
    string alertMsg = riskPctInput > 2.0 ? "⚠ Riesgo > 2% — Reducir" :
         capitalPct > 30                 ? "⚠ Alta concentración"     : "✓ Parámetros OK"
    color  alertCol = riskPctInput > 2.0 or capitalPct > 30 ?
         color.red : color.teal
    table.cell(psTable, 0, 6, alertMsg,
         text_color = alertCol, bgcolor = rowBg,
         text_size  = size.tiny, text_halign = text.align_left)
    table.cell(psTable, 1, 6, "", bgcolor = rowBg)

// ─── STOP LOSS DINÁMICO EN EL GRÁFICO ─────────────────────────
// Línea roja punteada que muestra el nivel de salida en tiempo real
plot(stopPrice, "Stop Loss ATR",
     color     = color.new(color.red, 30),
     style     = plot.style_linebr,
     linewidth = 1)
