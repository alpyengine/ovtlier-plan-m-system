// ═══════════════════════════════════════════════════════════════════
// © Ovtlier University | Trend Template
// Based on Christopher Uhl's stock selection methodology
// Adaptation of Minervini's Trend Template with Ovtlier principles
// ───────────────────────────────────────────────────────────────────
// VERSION HISTORY
// v1 | 2026-04-28 | Initial release — 8-condition Trend Template
//                   table checklist, SMA plots, bg color, alerts,
//                   version control block embedded in header & table
// v7 | 2026-04-29 | Visual redesign — light palette consistent with
//                   Market Dashboard, Plan A and Position Sizer:
//                   th-bg #eef0f6, surface #ffffff/#f4f5f8 alternating,
//                   tag-green/tag-red badges, amber Step 4 header,
//                   black text for max contrast, configurable text size
// ═══════════════════════════════════════════════════════════════════
//@version=6

// ─── VERSION CONTROL ───────────────────────────────────────────────
string SCRIPT_VERSION = "v7"
string SCRIPT_DATE    = "2026-04-29"
string SCRIPT_NAME    = "Ovtlier Trend Template"

indicator(SCRIPT_NAME + " " + SCRIPT_VERSION, overlay = true, max_bars_back = 300)

// ─── INPUTS ────────────────────────────────────────────────────────
bool  showTableInput  = input.bool(true,            "Show Checklist Table",  group = "🎨 Display")
bool  showMAsInput    = input.bool(true,            "Show Moving Averages",  group = "🎨 Display")
bool  showBgInput     = input.bool(true,            "Show Background Color", group = "🎨 Display")
string posInput       = input.string("Top Right",   "Table Position",        group = "🎨 Display",
                         options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"])
string tamPanelInput  = input.string("small",       "Tamaño de texto",        group = "🎨 Display",
                         options = ["tiny", "small", "normal", "large"])

int   sma50Len   = input.int(50,  "SMA 50 Length",  group = "📊 Moving Average Parameters", minval = 1)
int   sma150Len  = input.int(150, "SMA 150 Length", group = "📊 Moving Average Parameters", minval = 1)
int   sma200Len  = input.int(200, "SMA 200 Length", group = "📊 Moving Average Parameters", minval = 1)
int   sma200SlopePeriod = input.int(21, "SMA 200 Slope lookback (bars)", group = "📊 Moving Average Parameters", minval = 5)

float highPct    = input.float(25.0, "Max % below 52w High",  group = "📊 Price Range Parameters", minval = 1.0)
float lowPct     = input.float(25.0, "Min % above 52w Low",   group = "📊 Price Range Parameters", minval = 1.0)

// ─── STEP 4 INPUTS ─────────────────────────────────────────────────
float atrMaxMult    = input.float(2.5, "Max ATR multiplier (overextension limit)", group = "⚠️ Step 4 — Manual Checks", minval = 0.5, step = 0.1, tooltip = "Ovtlier limit: price must be within this many ATRs of SMA50. Default = 2.5")
int   earningsDays  = input.int(99,   "Days to next Earnings",                     group = "⚠️ Step 4 — Manual Checks", minval = 0,   maxval = 365, tooltip = "Enter manually. PASS = more than 21 days away. Update before each trade.")

// ─── MOVING AVERAGES ───────────────────────────────────────────────
float sma50  = ta.sma(close, sma50Len)
float sma150 = ta.sma(close, sma150Len)
float sma200 = ta.sma(close, sma200Len)

// ─── 52-WEEK HIGH / LOW ────────────────────────────────────────────
// 252 trading days ≈ 1 year; use 260 bars to be conservative
float high52w = ta.highest(high, 252)
float low52w  = ta.lowest(low,  252)

// ─── THE 8 TREND TEMPLATE CONDITIONS ──────────────────────────────
// C1: Price above SMA 150 (medium-term uptrend)
bool c1 = close > sma150

// C2: Price above SMA 200 (long-term uptrend)
bool c2 = close > sma200

// C3: SMA 150 above SMA 200 (ordered trend structure)
bool c3 = sma150 > sma200

// C4: SMA 200 has been rising for at least 1 month (slope check)
// We compare today's SMA200 vs SMA200 from `sma200SlopePeriod` bars ago
bool c4 = sma200 > sma200[sma200SlopePeriod]

// C5: SMA 50 above both SMA 150 and SMA 200 (short-term momentum leading)
bool c5 = sma50 > sma150 and sma50 > sma200

// C6: Price above SMA 50 (price above near-term momentum)
bool c6 = close > sma50

// C7: Price is at least X% above 52-week low (not buying a broken stock)
bool c7 = close >= low52w * (1 + lowPct / 100)

// C8: Price is within X% of 52-week high (near zone of strength)
bool c8 = close >= high52w * (1 - highPct / 100)

// ─── STEP 4 — ADDITIONAL CHECKS ────────────────────────────────────
// C9: Overextension check — distance from SMA50 must be < atrMaxMult × ATR(14)
float atr14          = ta.atr(14)
float distToSma50    = math.abs(close - sma50)
float atrMultiplier  = atr14 > 0 ? distToSma50 / atr14 : 0.0
bool  c9             = atrMultiplier < atrMaxMult

// C10: Resistance zone — no major swing high in next 2×ATR above price
// Pine cannot read future bars, so we check: was there a swing high in the
// 2×ATR zone above current price within the last 60 bars? (proxy for OB/resistance)
float resistanceTop    = close + 2 * atr14
float resistanceBottom = close
// Look back 60 bars for any bar whose HIGH entered the resistance zone
bool obFound = false
for i = 1 to 60
    if high[i] >= resistanceBottom and high[i] <= resistanceTop
        obFound := true
bool c10 = not obFound

// C11: Earnings window — manual input. PASS if more than 21 days away
bool c11 = earningsDays > 21

// ─── AGGREGATE SIGNAL ──────────────────────────────────────────────
int  condCount   = (c1 ? 1 : 0) + (c2 ? 1 : 0) + (c3 ? 1 : 0) + (c4 ? 1 : 0) +
                   (c5 ? 1 : 0) + (c6 ? 1 : 0) + (c7 ? 1 : 0) + (c8 ? 1 : 0)

// Full approval: all 8 conditions met → VALID BUY SETUP
bool fullApproval = condCount == 8

// Partial approval: 6-7 conditions met → WATCH (developing setup)
bool partialApproval = condCount >= 6 and condCount < 8

// ─── BACKGROUND COLOR ──────────────────────────────────────────────
// Subtle background to signal overall regime on current bar
color bgColor = fullApproval ? color.new(color.teal, 88) : partialApproval ? color.new(color.yellow, 90) : color.new(color.red, 93)

bgcolor(showBgInput ? bgColor : na, title = "Trend Template Background")

// ─── MOVING AVERAGE PLOTS ──────────────────────────────────────────
plot(showMAsInput ? sma50  : na, "SMA 50",  color = color.new(color.blue,   0), linewidth = 1)
plot(showMAsInput ? sma150 : na, "SMA 150", color = color.new(color.orange, 0), linewidth = 1)
plot(showMAsInput ? sma200 : na, "SMA 200", color = color.new(color.red,    0), linewidth = 2)

// ─── STEP 4 VISUAL — Resistance zone (2×ATR above price) ───────────
// Reuses atr14, resistanceTop, resistanceBottom from conditions block
p1 = plot(resistanceTop,    "Resist Zone Top (2×ATR)",    color = color.new(color.orange, 70), linewidth = 1, style = plot.style_circles)
p2 = plot(resistanceBottom + atr14, "Resist Zone Bottom (1×ATR)", color = color.new(color.orange, 70), linewidth = 1, style = plot.style_circles)
fill(p1, p2, color = color.new(color.orange, 88), title = "Resistance Watch Zone")

// ─── TABLE SETUP ───────────────────────────────────────────────────
//@function Returns the table.position constant based on a string input
tablePos(string pos) =>
    pos == "Top Right" ? position.top_right : pos == "Top Left" ? position.top_left : pos == "Bottom Right" ? position.bottom_right : position.bottom_left

//@function Converts string size input to Pine size constant
textSize(string s) =>
    s == "tiny" ? size.tiny : s == "normal" ? size.normal : s == "large" ? size.large : size.small

// ─── LIGHT PALETTE ─────────────────────────────────────────────────
// Backgrounds
color C_TH_BG      = color.new(#eef0f6, 0)   // header / subheader / footer
color C_SURFACE    = color.new(#ffffff,  0)   // odd rows
color C_SURFACE2   = color.new(#f4f5f8, 0)   // even rows (alternating)
color C_STEP4_BG   = color.new(#fef3c7, 0)   // amber — Step 4 section header
color C_TABLE_BORDER = color.new(#d1d5db, 0)

// Text
color C_TEXT       = color.new(#000000, 0)   // primary labels — black for max contrast
color C_TH_TEXT    = color.new(#000000, 0)   // header text — black
color C_MUTED      = color.new(#374151, 0)   // footer / subheader muted text

// Badges — PASS (tag-green)
color C_PASS_BG    = color.new(#dcfce7, 0)
color C_PASS_TEXT  = color.new(#14532d, 0)

// Badges — FAIL (tag-red)
color C_FAIL_BG    = color.new(#fee2e2, 0)
color C_FAIL_TEXT  = color.new(#991b1b, 0)

// Verdict rows
color C_VRD_BUY_BG   = color.new(#dcfce7, 0)
color C_VRD_BUY_TEXT = color.new(#14532d, 0)
color C_VRD_WCH_BG   = color.new(#fef3c7, 0)
color C_VRD_WCH_TEXT = color.new(#b45309, 0)
color C_VRD_NOT_BG   = color.new(#fee2e2, 0)
color C_VRD_NOT_TEXT = color.new(#991b1b, 0)

//@function Returns badge label
condLabel(bool cond) =>
    cond ? "✅  PASS" : "❌  FAIL"

//@function Returns badge background color
condBg(bool cond) =>
    cond ? C_PASS_BG : C_FAIL_BG

//@function Returns badge text color
condTxt(bool cond) =>
    cond ? C_PASS_TEXT : C_FAIL_TEXT

//@function Returns alternating row background (odd=surface, even=surface2)
rowBg(int row) =>
    row % 2 == 0 ? C_SURFACE : C_SURFACE2

// ─── TABLE RENDERING ───────────────────────────────────────────────
var table trendTable = na

if barstate.islast and showTableInput
    if not na(trendTable)
        table.delete(trendTable)

    string TS = textSize(tamPanelInput)  // resolved size constant

    trendTable := table.new(
         position     = tablePos(posInput),
         columns      = 2,
         rows         = 17,
         bgcolor      = C_TH_BG,
         border_width = 1,
         border_color = C_TABLE_BORDER,
         frame_width  = 2,
         frame_color  = C_TABLE_BORDER)

    // ── Row 0: Main header ──
    table.cell(trendTable, 0, 0, "OVTLIER TREND TEMPLATE",
         bgcolor = C_TH_BG, text_color = C_TH_TEXT,
         text_size = size.normal, text_halign = text.align_center)
    table.merge_cells(trendTable, 0, 0, 1, 0)

    // ── Row 1: Ticker + Timeframe subheader ──
    table.cell(trendTable, 0, 1, syminfo.ticker + " | " + timeframe.period,
         bgcolor = C_TH_BG, text_color = C_MUTED,
         text_size = TS, text_halign = text.align_center)
    table.merge_cells(trendTable, 0, 1, 1, 1)

    // ── Row 2: Column headers ──
    table.cell(trendTable, 0, 2, "CONDITION",
         bgcolor = C_TH_BG, text_color = C_TH_TEXT,
         text_size = TS, text_halign = text.align_left)
    table.cell(trendTable, 1, 2, "STATUS",
         bgcolor = C_TH_BG, text_color = C_TH_TEXT,
         text_size = TS, text_halign = text.align_center)

    // ── Rows 3-10: C1-C8 (alternating surface/surface2) ──
    // C1
    table.cell(trendTable, 0, 3, "C1 · Price > SMA 150",
         bgcolor = rowBg(3), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 3, condLabel(c1),
         bgcolor = condBg(c1), text_color = condTxt(c1), text_size = TS, text_halign = text.align_center)

    // C2
    table.cell(trendTable, 0, 4, "C2 · Price > SMA 200",
         bgcolor = rowBg(4), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 4, condLabel(c2),
         bgcolor = condBg(c2), text_color = condTxt(c2), text_size = TS, text_halign = text.align_center)

    // C3
    table.cell(trendTable, 0, 5, "C3 · SMA 150 > SMA 200",
         bgcolor = rowBg(5), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 5, condLabel(c3),
         bgcolor = condBg(c3), text_color = condTxt(c3), text_size = TS, text_halign = text.align_center)

    // C4
    table.cell(trendTable, 0, 6, "C4 · SMA 200 slope ↑ (" + str.tostring(sma200SlopePeriod) + "b)",
         bgcolor = rowBg(6), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 6, condLabel(c4),
         bgcolor = condBg(c4), text_color = condTxt(c4), text_size = TS, text_halign = text.align_center)

    // C5
    table.cell(trendTable, 0, 7, "C5 · SMA 50 > SMA 150 & 200",
         bgcolor = rowBg(7), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 7, condLabel(c5),
         bgcolor = condBg(c5), text_color = condTxt(c5), text_size = TS, text_halign = text.align_center)

    // C6
    table.cell(trendTable, 0, 8, "C6 · Price > SMA 50",
         bgcolor = rowBg(8), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 8, condLabel(c6),
         bgcolor = condBg(c6), text_color = condTxt(c6), text_size = TS, text_halign = text.align_center)

    // C7
    table.cell(trendTable, 0, 9, "C7 · Price ≥ +" + str.tostring(lowPct, "#") + "% vs 52w Low",
         bgcolor = rowBg(9), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 9, condLabel(c7),
         bgcolor = condBg(c7), text_color = condTxt(c7), text_size = TS, text_halign = text.align_center)

    // C8
    table.cell(trendTable, 0, 10, "C8 · Price within " + str.tostring(highPct, "#") + "% of 52w High",
         bgcolor = rowBg(10), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 10, condLabel(c8),
         bgcolor = condBg(c8), text_color = condTxt(c8), text_size = TS, text_halign = text.align_center)

    // ── Row 11: Step 4 section header (amber) ──
    table.cell(trendTable, 0, 11, "STEP 4 — ADDITIONAL CHECKS",
         bgcolor = C_STEP4_BG, text_color = color.new(#b45309, 0),
         text_size = TS, text_halign = text.align_center)
    table.merge_cells(trendTable, 0, 11, 1, 11)

    // C9 — Overextension
    string c9Label = "C9 · Overext. " + str.tostring(atrMultiplier, "#.##") + " ATR (max " + str.tostring(atrMaxMult, "#.#") + ")"
    table.cell(trendTable, 0, 12, c9Label,
         bgcolor = rowBg(12), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 12, condLabel(c9),
         bgcolor = condBg(c9), text_color = condTxt(c9), text_size = TS, text_halign = text.align_center)

    // C10 — Resistance / Order Block zone
    table.cell(trendTable, 0, 13, "C10 · Resistance in 2×ATR zone above",
         bgcolor = rowBg(13), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 13, condLabel(c10),
         bgcolor = condBg(c10), text_color = condTxt(c10), text_size = TS, text_halign = text.align_center)

    // C11 — Earnings window
    string c11Label = "C11 · Earnings in " + str.tostring(earningsDays) + "d (min 21d)"
    table.cell(trendTable, 0, 14, c11Label,
         bgcolor = rowBg(14), text_color = C_TEXT, text_size = TS)
    table.cell(trendTable, 1, 14, condLabel(c11),
         bgcolor = condBg(c11), text_color = condTxt(c11), text_size = TS, text_halign = text.align_center)

    // ── Row 15: Global verdict ──
    string verdict    = fullApproval ? "🟢  VALID BUY SETUP" : partialApproval ? "🟡  WATCH (" + str.tostring(condCount) + "/8)" : "🔴  NOT READY (" + str.tostring(condCount) + "/8)"
    color  verdictBg  = fullApproval ? C_VRD_BUY_BG  : partialApproval ? C_VRD_WCH_BG  : C_VRD_NOT_BG
    color  verdictTxt = fullApproval ? C_VRD_BUY_TEXT : partialApproval ? C_VRD_WCH_TEXT : C_VRD_NOT_TEXT

    table.cell(trendTable, 0, 15, verdict,
         bgcolor = verdictBg, text_color = verdictTxt,
         text_size = size.normal, text_halign = text.align_center)
    table.merge_cells(trendTable, 0, 15, 1, 15)

    // ── Row 16: Version footer ──
    table.cell(trendTable, 0, 16, SCRIPT_NAME + " " + SCRIPT_VERSION + " · " + SCRIPT_DATE,
         bgcolor = C_TH_BG, text_color = C_MUTED,
         text_size = size.tiny, text_halign = text.align_center)
    table.merge_cells(trendTable, 0, 16, 1, 16)

// ─── ALERT CONDITIONS ──────────────────────────────────────────────
// alertcondition() requires const string — use alert() instead to support dynamic messages
string alertBase = syminfo.ticker + " | Ovtlier Trend Template " + SCRIPT_VERSION + " | " +
                   str.tostring(condCount) + "/8 | Price: " + str.tostring(close, "#.##")

if fullApproval
    alert("🟢 VALID BUY SETUP | " + alertBase, alert.freq_once_per_bar_close)

if partialApproval
    alert("🟡 WATCH | " + alertBase, alert.freq_once_per_bar_close)

if ta.crossover(close, sma200)
    alert("📈 Price crossed above SMA 200 | " + alertBase, alert.freq_once_per_bar_close)

// Static alertcondition triggers (no dynamic string — TradingView alert panel compatible)
alertcondition(fullApproval,             title = "✅ Full Approval (8/8)",          message = "Ovtlier Trend Template: VALID BUY SETUP (8/8)")
alertcondition(partialApproval,          title = "🟡 Watch Setup (6-7/8)",          message = "Ovtlier Trend Template: WATCH setup developing")
alertcondition(ta.crossover(close, sma200), title = "Price crossed above SMA 200",  message = "Ovtlier Trend Template: Price > SMA 200 crossover")
