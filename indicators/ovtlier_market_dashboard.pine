// This source code is subject to the terms of the Mozilla Public License 2.0
// © Outlier-Style Market Dashboard v5.2
// Cambios respecto a v4:
//   · Añadido sector Software (IGV) entre Tecnología y Financiero
//   · Añadidos sectores Agricultura (DBA), Commodities (DBC) y Metales Preciosos (GLD) al final
//   · XLE pasa a ser sector de pleno derecho (sin exclusión forzada por defecto)
//   · totalActive y activeSectors actualizados para los 11 sectores
// Cambios respecto a v5:
//   · Tabla ampliada a 19 filas: fila 6 exclusiva para contador, fila 7 para headers de columna
//   · Header "Tendencia" ahora visible y alineado con su columna
//   · Estado del sector diferencia tres casos: ✔ OPERAR / ◎ ESPERAR / ✘ BAJISTA
// Cambios respecto a v5.1 (encargo La Granja):
//   · PARTE 1 — Corrección de repintado: todas las llamadas request.security() usan
//     lookahead = barmerge.lookahead_on y offset [1] en la expresión, igual que Plan A
//   · "D" fijo en f_relStrength() mantenido por diseño (RS siempre en días, independiente
//     del timeframe del gráfico) — solo se añade lookahead_on + [1]
//   · PARTE 2 — Rediseño visual: paleta clara (design-v5) sustituye la paleta oscura anterior
//   · Input tamPanelInput añadido: tamaño de texto configurable (tiny/small/normal/large)
//@version=6
indicator("Market Dashboard v5.2", overlay = true, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════
string grp1 = "SPY — Trend Settings"
int   emaFastInput   = input.int(10,  "EMA Fast",  minval = 1, group = grp1)
int   emaMidInput    = input.int(20,  "EMA Mid",   minval = 1, group = grp1)
int   emaSlowInput   = input.int(50,  "EMA Slow",  minval = 1, group = grp1)

string grp2 = "Momentum"
int   rsiLengthInput = input.int(14, "RSI Length",             minval = 1,  group = grp2)
int   rsiBullInput   = input.int(55, "RSI Bull threshold (>)", minval = 40, maxval = 80, group = grp2)

string grp3 = "Volume"
int   volMaInput     = input.int(20, "Volume MA Length", minval = 5, group = grp3)

string grp4 = "Sectors — Tickers"
string tkXLK  = input.symbol("AMEX:XLK",  "Tecnología",        group = grp4)
string tkIGV  = input.symbol("AMEX:IGV",  "Software",          group = grp4)
string tkXLF  = input.symbol("AMEX:XLF",  "Financiero",        group = grp4)
string tkXLI  = input.symbol("AMEX:XLI",  "Industrial",        group = grp4)
string tkXLY  = input.symbol("AMEX:XLY",  "Consumo Discr.",    group = grp4)
string tkXLC  = input.symbol("AMEX:XLC",  "Comunicaciones",    group = grp4)
string tkXLV  = input.symbol("AMEX:XLV",  "Sanidad",           group = grp4)
string tkXLE  = input.symbol("AMEX:XLE",  "Energia",           group = grp4)
string tkDBA  = input.symbol("AMEX:DBA",  "Agricultura",       group = grp4)
string tkDBC  = input.symbol("AMEX:DBC",  "Commodities",       group = grp4)
string tkGLD  = input.symbol("AMEX:GLD",  "Metales Preciosos", group = grp4)

string grp5 = "Sectors — Excluir del conteo"
bool  excludeXLKInput = input.bool(false, "Excluir Tecnologia (XLK)",       group = grp5)
bool  excludeIGVInput = input.bool(false, "Excluir Software (IGV)",          group = grp5)
bool  excludeXLFInput = input.bool(false, "Excluir Financiero (XLF)",        group = grp5)
bool  excludeXLIInput = input.bool(false, "Excluir Industrial (XLI)",        group = grp5)
bool  excludeXLYInput = input.bool(false, "Excluir Consumo Discr. (XLY)",    group = grp5)
bool  excludeXLCInput = input.bool(false, "Excluir Comunicaciones (XLC)",    group = grp5)
bool  excludeXLVInput = input.bool(true,  "Excluir Sanidad (XLV)",           group = grp5)
bool  excludeXLEInput = input.bool(true,  "Excluir Energia (XLE)",           group = grp5)
bool  excludeDBAInput = input.bool(true,  "Excluir Agricultura (DBA)",       group = grp5)
bool  excludeDBCInput = input.bool(true,  "Excluir Commodities (DBC)",       group = grp5)
bool  excludeGLDInput = input.bool(true,  "Excluir Metales Preciosos (GLD)", group = grp5)

string grp6 = "Dashboard"
int    minSectorsInput  = input.int(3, "Min. sectores alcistas para operar", minval = 1, maxval = 11, group = grp6)
string posInput         = input.string("Top Right", "Posicion tabla",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grp6)

string grpVis = "Visual"
string tamPanelInput = input.string("small", "Tamano de texto",
     options = ["tiny", "small", "normal", "large"], group = grpVis)

// ═══════════════════════════════════════════════════════════
// HELPERS — tamanio de texto
// ═══════════════════════════════════════════════════════════
//@function Convierte el string del input en la constante size.*
f_textSize(string s) =>
    switch s
        "tiny"   => size.tiny
        "normal" => size.normal
        "large"  => size.large
        =>          size.small   // default

// Resolución única — se usa en todas las celdas
string TS     = f_textSize(tamPanelInput)   // tamanio normal de celda
string TS_SML = size.tiny                   // tamanio reducido (celdas de descripcion)

// ═══════════════════════════════════════════════════════════
// FUNCIONES HELPER — datos de mercado
// ═══════════════════════════════════════════════════════════

// PARTE 1: lookahead_on + [1] en TODAS las llamadas request.security()
// Patron identico al usado en Plan A — sin excepcion.

//@function Retorna true si el simbolo cumple el Outlier Trend Template
//@param sym (string) Ticker del simbolo a evaluar
f_isBullish(string sym) =>
    [c, e10, e20, e50] = request.security(sym, timeframe.period,
         [close[1],
          ta.ema(close, emaFastInput)[1],
          ta.ema(close, emaMidInput)[1],
          ta.ema(close, emaSlowInput)[1]],
         lookahead = barmerge.lookahead_on)
    e10 > e20 and c > e50

//@function Retorna la fuerza relativa del simbolo vs SPY en N dias
//  "D" fijo por diseno: la RS siempre mide 20 dias calendario,
//  independientemente del timeframe del grafico activo.
//@param sym     (string) Ticker del sector
//@param spySym  (string) Ticker del benchmark (SPY)
//@param lookback (int)   Periodo de comparacion en dias
f_relStrength(string sym, string spySym, int lookback) =>
    float symClose = request.security(sym,    "D", close[1], lookahead = barmerge.lookahead_on)
    float spyClose = request.security(spySym, "D", close[1], lookahead = barmerge.lookahead_on)
    float symRet   = (symClose / symClose[lookback] - 1) * 100
    float spyRet   = (spyClose / spyClose[lookback] - 1) * 100
    symRet - spyRet   // positivo = supera al mercado

// ═══════════════════════════════════════════════════════════
// CALCULOS SPY — lookahead_on + [1] en todas las llamadas
// ═══════════════════════════════════════════════════════════
float spyClose  = request.security("AMEX:SPY", timeframe.period, close[1],                      lookahead = barmerge.lookahead_on)
float spyEma10  = request.security("AMEX:SPY", timeframe.period, ta.ema(close, emaFastInput)[1], lookahead = barmerge.lookahead_on)
float spyEma20  = request.security("AMEX:SPY", timeframe.period, ta.ema(close, emaMidInput)[1],  lookahead = barmerge.lookahead_on)
float spyEma50  = request.security("AMEX:SPY", timeframe.period, ta.ema(close, emaSlowInput)[1], lookahead = barmerge.lookahead_on)
float spyEma200 = request.security("AMEX:SPY", timeframe.period, ta.ema(close, 200)[1],          lookahead = barmerge.lookahead_on)
float spyRsi    = request.security("AMEX:SPY", timeframe.period, ta.rsi(close, rsiLengthInput)[1],lookahead = barmerge.lookahead_on)
float spyVol    = request.security("AMEX:SPY", timeframe.period, volume[1],                      lookahead = barmerge.lookahead_on)
float spyVolMa  = request.security("AMEX:SPY", timeframe.period, ta.sma(volume, volMaInput)[1],  lookahead = barmerge.lookahead_on)

// Condiciones SPY
bool spyTrend   = spyEma10 > spyEma20 and spyClose > spyEma50
bool spyBuy     = spyRsi > rsiBullInput
bool spyVolOk   = spyVol > spyVolMa
bool spyAllGood = spyTrend and spyBuy

// ═══════════════════════════════════════════════════════════
// AMPLITUD — proxy dual: RSI(14) > 50 y precio > EMA200
// ═══════════════════════════════════════════════════════════
bool breadthOk = spyRsi > 50 and spyClose > spyEma200

// ═══════════════════════════════════════════════════════════
// SECTORES — tendencia y fuerza relativa vs SPY
// ═══════════════════════════════════════════════════════════
bool xlkBull = f_isBullish(tkXLK)
bool igvBull = f_isBullish(tkIGV)
bool xlfBull = f_isBullish(tkXLF)
bool xliBull = f_isBullish(tkXLI)
bool xlyBull = f_isBullish(tkXLY)
bool xlcBull = f_isBullish(tkXLC)
bool xlvBull = f_isBullish(tkXLV)
bool xleBull = f_isBullish(tkXLE)
bool dbaBull = f_isBullish(tkDBA)
bool dbcBull = f_isBullish(tkDBC)
bool gldBull = f_isBullish(tkGLD)

float xlkRs = f_relStrength(tkXLK, "AMEX:SPY", 20)
float igvRs = f_relStrength(tkIGV, "AMEX:SPY", 20)
float xlfRs = f_relStrength(tkXLF, "AMEX:SPY", 20)
float xliRs = f_relStrength(tkXLI, "AMEX:SPY", 20)
float xlyRs = f_relStrength(tkXLY, "AMEX:SPY", 20)
float xlcRs = f_relStrength(tkXLC, "AMEX:SPY", 20)
float xlvRs = f_relStrength(tkXLV, "AMEX:SPY", 20)
float xleRs = f_relStrength(tkXLE, "AMEX:SPY", 20)
float dbaRs = f_relStrength(tkDBA, "AMEX:SPY", 20)
float dbcRs = f_relStrength(tkDBC, "AMEX:SPY", 20)
float gldRs = f_relStrength(tkGLD, "AMEX:SPY", 20)

// Sectores alcistas no excluidos (cuentan para el semaforo)
int activeSectors =
     (not excludeXLKInput and xlkBull ? 1 : 0) +
     (not excludeIGVInput and igvBull ? 1 : 0) +
     (not excludeXLFInput and xlfBull ? 1 : 0) +
     (not excludeXLIInput and xliBull ? 1 : 0) +
     (not excludeXLYInput and xlyBull ? 1 : 0) +
     (not excludeXLCInput and xlcBull ? 1 : 0) +
     (not excludeXLVInput and xlvBull ? 1 : 0) +
     (not excludeXLEInput and xleBull ? 1 : 0) +
     (not excludeDBAInput and dbaBull ? 1 : 0) +
     (not excludeDBCInput and dbcBull ? 1 : 0) +
     (not excludeGLDInput and gldBull ? 1 : 0)

// Total de sectores no excluidos (denominador del contador)
int totalActive =
     (not excludeXLKInput ? 1 : 0) + (not excludeIGVInput ? 1 : 0) +
     (not excludeXLFInput ? 1 : 0) + (not excludeXLIInput ? 1 : 0) +
     (not excludeXLYInput ? 1 : 0) + (not excludeXLCInput ? 1 : 0) +
     (not excludeXLVInput ? 1 : 0) + (not excludeXLEInput ? 1 : 0) +
     (not excludeDBAInput ? 1 : 0) + (not excludeDBCInput ? 1 : 0) +
     (not excludeGLDInput ? 1 : 0)

// Semaforo de tres estados
bool marketGreen  = spyAllGood and breadthOk and activeSectors >= minSectorsInput
bool marketYellow = spyAllGood and (not breadthOk or activeSectors < minSectorsInput)

// ═══════════════════════════════════════════════════════════
// COLORES — Paleta clara design-v5 (PARTE 2)
// ═══════════════════════════════════════════════════════════

// Fondos estructurales
color CLR_SURFACE   = #ffffff          // fondo filas impares
color CLR_SURFACE2  = #f4f5f8          // fondo filas pares (alternas)
color CLR_HEADER_BG = #eef0f6          // fondo cabeceras
color CLR_BORDER    = color.new(#000000, 91)   // borde sutil

// Texto
color CLR_TEXT      = #1a1f2e          // texto principal (etiquetas)
color CLR_TEXT2     = #4b5563          // texto secundario (valores, descripciones)
color CLR_HEADER_TC = #374151          // texto en cabeceras

// Badges de estado — fondo claro / texto oscuro
color CLR_GREEN_BG  = #dcfce7          // badge PASS — verde claro
color CLR_GREEN_TC  = #14532d          // texto verde oscuro
color CLR_RED_BG    = #fee2e2          // badge FAIL — rojo claro
color CLR_RED_TC    = #991b1b          // texto rojo oscuro
color CLR_AMBER_BG  = #fef3c7          // badge WARN — ambar claro
color CLR_AMBER_TC  = #b45309          // texto ambar oscuro

// Sector excluido
color CLR_EXCL_BG   = #f4f5f8
color CLR_EXCL_TC   = color.new(#4b5563, 50)

// Semaforo global (fila 0) — colores con algo mas de intensidad para destacar
color CLR_SEM_GREEN_BG  = color.new(#dcfce7, 10)
color CLR_SEM_GREEN_TC  = #14532d
color CLR_SEM_RED_BG    = color.new(#fee2e2, 10)
color CLR_SEM_RED_TC    = #991b1b
color CLR_SEM_AMBER_BG  = color.new(#fef3c7, 10)
color CLR_SEM_AMBER_TC  = #b45309

//@function Color de fondo badge segun condicion booleana (verde/rojo)
f_badgeBg(bool cond) => cond ? CLR_GREEN_BG : CLR_RED_BG
//@function Color de texto badge segun condicion booleana
f_badgeTc(bool cond) => cond ? CLR_GREEN_TC : CLR_RED_TC

//@function Color del valor de RS relativa (verde / ambar / rojo)
f_rsColor(float val) =>
    na(val) ? CLR_TEXT2 : val > 1.0 ? CLR_GREEN_TC : val < -1.0 ? CLR_RED_TC : CLR_AMBER_TC

// ═══════════════════════════════════════════════════════════
// UDT — Sector Data
// ═══════════════════════════════════════════════════════════
type SectorData
    string name
    bool   bull
    float  rs
    bool   excluded

// ═══════════════════════════════════════════════════════════
// TABLA — 4 columnas x 19 filas
// ═══════════════════════════════════════════════════════════
var string tablePos = posInput == "Top Right"    ? position.top_right    :
     posInput == "Top Left"     ? position.top_left     :
     posInput == "Bottom Right" ? position.bottom_right :
     position.bottom_left

var table dashTable = table.new(
     tablePos, 4, 19,
     bgcolor      = CLR_SURFACE,
     border_color = CLR_BORDER,
     border_width = 1,
     frame_color  = CLR_BORDER,
     frame_width  = 1)

//@function Escribe una celda estandar en el dashboard
f_cell(int col, int row, string txt, color bg, color tc, string ts) =>
    table.cell(dashTable, col, row,
         text        = txt,
         bgcolor     = bg,
         text_color  = tc,
         text_size   = ts,
         text_halign = text.align_center)

if barstate.islast

    // ── FILA 0: Senal principal — Operar hoy? ─────────────
    string titleTxt = marketGreen  ? "OPERAR HOY - Condiciones OK" :
         marketYellow ? "PRECAUCION - Condiciones parciales" :
         "NO OPERAR - Mercado bajista"
    color titleBg = marketGreen  ? CLR_SEM_GREEN_BG :
         marketYellow ? CLR_SEM_AMBER_BG  :
         CLR_SEM_RED_BG
    color titleTc = marketGreen  ? CLR_SEM_GREEN_TC :
         marketYellow ? CLR_SEM_AMBER_TC  :
         CLR_SEM_RED_TC
    table.cell(dashTable, 0, 0,
         text        = titleTxt,
         bgcolor     = titleBg,
         text_color  = titleTc,
         text_size   = size.normal,
         text_halign = text.align_center)
    table.merge_cells(dashTable, 0, 0, 3, 0)

    // ── FILA 1: Headers seccion SPY ───────────────────────
    f_cell(0, 1, "SPY",    CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(1, 1, "Estado", CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(2, 1, "Valor",  CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(3, 1, "Senal",  CLR_HEADER_BG, CLR_HEADER_TC, TS)

    // ── FILA 2: Tendencia SPY ─────────────────────────────
    f_cell(0, 2, "Tendencia",   CLR_SURFACE,  CLR_TEXT,  TS)
    f_cell(1, 2, spyTrend ? "ALCISTA" : "BAJISTA",
         f_badgeBg(spyTrend), f_badgeTc(spyTrend), TS)
    f_cell(2, 2, "E10>E20>E50", CLR_SURFACE,  CLR_TEXT2, TS_SML)
    f_cell(3, 2, str.tostring(spyClose, "#.##"), CLR_SURFACE, CLR_TEXT, TS)

    // ── FILA 3: RSI SPY ───────────────────────────────────
    f_cell(0, 3, "Momentum", CLR_SURFACE2, CLR_TEXT,  TS)
    f_cell(1, 3, spyBuy ? "COMPRA" : "NEUTRO",
         f_badgeBg(spyBuy), f_badgeTc(spyBuy), TS)
    f_cell(2, 3, "RSI(" + str.tostring(rsiLengthInput) + ")>" + str.tostring(rsiBullInput),
         CLR_SURFACE2, CLR_TEXT2, TS_SML)
    f_cell(3, 3, str.tostring(spyRsi, "#.#"), CLR_SURFACE2, CLR_TEXT, TS)

    // ── FILA 4: Volumen SPY ───────────────────────────────
    f_cell(0, 4, "Volumen", CLR_SURFACE, CLR_TEXT, TS)
    f_cell(1, 4, spyVolOk ? "ALTO" : "BAJO",
         spyVolOk ? CLR_GREEN_BG : CLR_AMBER_BG,
         spyVolOk ? CLR_GREEN_TC : CLR_AMBER_TC, TS)
    f_cell(2, 4, "Vol > MA" + str.tostring(volMaInput), CLR_SURFACE, CLR_TEXT2, TS_SML)
    f_cell(3, 4, "", CLR_SURFACE, CLR_TEXT, TS)

    // ── FILA 5: Amplitud ──────────────────────────────────
    f_cell(0, 5, "Amplitud", CLR_SURFACE2, CLR_TEXT, TS)
    f_cell(1, 5, breadthOk ? ">50%" : "<50%",
         f_badgeBg(breadthOk), f_badgeTc(breadthOk), TS)
    string mmfiStr = "RSI:" + str.tostring(spyRsi, "#.#") + " E200:" + (spyClose > spyEma200 ? "+" : "-")
    f_cell(2, 5, "RSI>50+E200", CLR_SURFACE2, CLR_TEXT2, TS_SML)
    f_cell(3, 5, mmfiStr,       CLR_SURFACE2, CLR_TEXT,  TS_SML)
    table.merge_cells(dashTable, 2, 5, 3, 5)

    // ── FILA 6: Contador de sectores (fusionada) ──────────
    string sectorCountTxt = str.tostring(activeSectors) + "/" + str.tostring(totalActive) + " alcistas"
    color  sectorCountBg  = activeSectors >= minSectorsInput ? CLR_GREEN_BG : CLR_RED_BG
    color  sectorCountTc  = activeSectors >= minSectorsInput ? CLR_GREEN_TC : CLR_RED_TC
    table.cell(dashTable, 0, 6,
         text        = "SECTORES  " + sectorCountTxt,
         bgcolor     = sectorCountBg,
         text_color  = sectorCountTc,
         text_size   = TS,
         text_halign = text.align_center)
    table.merge_cells(dashTable, 0, 6, 3, 6)

    // ── FILA 7: Headers de columna de sectores ────────────
    f_cell(0, 7, "Sector",    CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(1, 7, "Tendencia", CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(2, 7, "RS 20d",    CLR_HEADER_BG, CLR_HEADER_TC, TS)
    f_cell(3, 7, "Estado",    CLR_HEADER_BG, CLR_HEADER_TC, TS)

    // ── FILAS 8-18: Los 11 sectores ───────────────────────
    array<SectorData> sectors = array.from(
         SectorData.new("Tecnologia  XLK", xlkBull, xlkRs, excludeXLKInput),
         SectorData.new("Software    IGV", igvBull, igvRs, excludeIGVInput),
         SectorData.new("Financiero  XLF", xlfBull, xlfRs, excludeXLFInput),
         SectorData.new("Industrial  XLI", xliBull, xliRs, excludeXLIInput),
         SectorData.new("Consumo Dis XLY", xlyBull, xlyRs, excludeXLYInput),
         SectorData.new("Comunicac.  XLC", xlcBull, xlcRs, excludeXLCInput),
         SectorData.new("Sanidad     XLV", xlvBull, xlvRs, excludeXLVInput),
         SectorData.new("Energia     XLE", xleBull, xleRs, excludeXLEInput),
         SectorData.new("Agricultura DBA", dbaBull, dbaRs, excludeDBAInput),
         SectorData.new("Commodities DBC", dbcBull, dbcRs, excludeDBCInput),
         SectorData.new("Met. Prec.  GLD", gldBull, gldRs, excludeGLDInput))

    for i = 0 to 10
        SectorData s   = array.get(sectors, i)
        int        row = i + 8
        // Filas alternas: pares = CLR_SURFACE, impares = CLR_SURFACE2
        color rowBg = s.excluded ? CLR_EXCL_BG : (row % 2 == 0 ? CLR_SURFACE : CLR_SURFACE2)

        // Columna 0 — nombre del sector
        f_cell(0, row, s.name,
             rowBg,
             s.excluded ? CLR_EXCL_TC : CLR_TEXT,
             TS)

        // Columna 1 — tendencia alcista / bajista
        f_cell(1, row,
             s.bull ? "Alcista" : "Bajista",
             s.excluded ? rowBg : (s.bull ? CLR_GREEN_BG : CLR_RED_BG),
             s.excluded ? CLR_EXCL_TC : (s.bull ? CLR_GREEN_TC : CLR_RED_TC),
             TS)

        // Columna 2 — fuerza relativa vs SPY 20d
        f_cell(2, row,
             not na(s.rs) ? (s.rs > 0 ? "+" : "") + str.tostring(s.rs, "#.##") + "%" : "-",
             rowBg,
             s.excluded ? CLR_EXCL_TC : f_rsColor(s.rs),
             TS)

        // Columna 3 — estado (tres niveles):
        //   OPERAR  -> alcista Y RS positiva  -> badge verde
        //   ESPERAR -> alcista pero RS negativa -> badge ambar
        //   BAJISTA -> tendencia bajista        -> badge rojo
        string statusTxt = s.excluded  ? "EXCLUIDO" :
             not s.bull               ? "BAJISTA"  :
             s.rs > 0                 ? "OPERAR"   : "ESPERAR"
        color  statusBg  = s.excluded  ? rowBg      :
             not s.bull               ? CLR_RED_BG   :
             s.rs > 0                 ? CLR_GREEN_BG : CLR_AMBER_BG
        color  statusTc  = s.excluded  ? CLR_EXCL_TC :
             not s.bull               ? CLR_RED_TC   :
             s.rs > 0                 ? CLR_GREEN_TC : CLR_AMBER_TC
        f_cell(3, row, statusTxt, statusBg, statusTc, TS)

// ═══════════════════════════════════════════════════════════
// FONDO DE VELA — tres estados segun regimen de mercado
// ═══════════════════════════════════════════════════════════
bgcolor(
     marketGreen  ? color.new(#dcfce7, 88) :
     marketYellow ? color.new(#fef3c7, 88) :
     color.new(#fee2e2, 88),
     title = "Market background")

// ═══════════════════════════════════════════════════════════
// ALERTAS — transiciones de regimen de mercado
// ═══════════════════════════════════════════════════════════
alertcondition(marketGreen  and not marketGreen[1],
     title   = "Mercado Verde - Operar",
     message = "MARKET DASHBOARD | Condiciones completas - Plan M activo")
alertcondition(marketYellow and not marketYellow[1],
     title   = "Mercado Amarillo - Precaucion",
     message = "MARKET DASHBOARD | Condiciones parciales - reducir exposicion")
alertcondition(not marketGreen and not marketYellow and (marketGreen[1] or marketYellow[1]),
     title   = "Mercado Rojo - No operar",
     message = "MARKET DASHBOARD | Mercado bajista - fuera del mercado")
